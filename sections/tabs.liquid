{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<style>
      ul.custom--tabs {
    list-style-type: none;
    max-width: var(--page-width);
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 20px;
      }
  ul.lumin-tab-{{ section.id }} {
             justify-content: {{ section.settings.tab_font_align }};
    {% if section.settings.show_border %} border-bottom: .1rem solid rgba(var(--color-foreground), .08);{% endif %}
        }
    .custom--tabs .tab__list{
      display: inline-block;
      border-top-left-radius: 4px;
      border-top-right-radius: 4px;
    }
      .custom__tab-content
      {
          display:none;
      }
      .custom__tab-content.active
      {
        display:block;
        padding-top: 20px;
        padding-bottom: 20px;
      }
      .tab__list h4.custom-tab
      {
          display:inline-block !important;
          padding:10px 15px !important;
          cursor: pointer !important;
        margin: 0px !important;
      }
      .active-always{
        display: block !important;
      }
      .tab__list h4.custom-tab.active {
          color:rgb(var(--color-button))!important;
          border-bottom:2px solid rgb(var(--color-button))!important;
      }
  .lumin-tab-{{section.id}} h4 {
    font-size: {{section.settings.tab_font}}px;
  }
  .custom__tab-content p:first-child
      {
          margin-top:0;
      }
  .lumin-tab-content-{{ section.id }} {
              text-align: {{ section.settings.tab_content_align }};
        }

    @media only screen and (max-width: 576px)
      {
        ul.custom--tabs {
        }
        .custom--tabs .tab__list .custom-tab{
          width: 100%;
          border-bottom: none !important;

        }
        .tab__list h4.custom-tab
      {
       padding: 7px 2px !important;
        margin: 10px 0px 0px 0px !important;
      }
        .custom__tab-content.active{

        }
        .lumin-tab-{{section.id}} h4 {
    font-size: {{section.settings.tab_font_mb}}px;
  }
          ul.lumin-tab-{{ section.id }} {
              justify-content: {{ section.settings.tab_font_mb_align }};
        }
        .lumin-tab-content-{{ section.id }} {
              text-align: {{ section.settings.tab_content_align_mb }};
        }
      }
</style>
<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.tabs_color_scheme }}">
  <ul class="lumin-tab-{{section.id}} custom--tabs page-width">
    {% for block in section.blocks %}
      {% if block.type == 'tab' %}
        <li class="tab__list {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }}>
          <h4
            class="custom-tab {% if forloop.first %}active{% endif %}"
            data-content-id="content--{{ block.id }}--{{ section.id }}"
          >
            {{ block.settings.heading }}
          </h4>
        </li>
      {% endif %}
    {% endfor %}
  </ul>

  {% for block in section.blocks %}
    {% if block.type == 'tab' %}
      <div
        id="content--{{ block.id }}--{{ section.id }}"
        class="custom__tab-content lumin-tab-content-{{ section.id }} page-width {% if forloop.first %}active{% endif %}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.description %}
          {{ product.description }}
        {% else %}
          {{ block.settings.tab_content }}
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
</div>

{% javascript %}
  tabs= document.querySelectorAll('.custom-tab');
  tabContents= document.querySelectorAll('.custom__tab-content');

  tabs.forEach(function(tab){
      tab.addEventListener('click',function(){

          contentId = this.dataset.contentId;
          content = document.getElementById(contentId);

          tabContents.forEach(function(content){
              content.classList.remove('active');
          });

          tabs.forEach(function(tab){
              tab.classList.remove('active');
          });

          this.classList.add('active');
          content.classList.add('active');
      });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Tabs",
  "disabled_on": {
  "groups": ["header", "custom.popup", "footer"]
  },
  "settings": [
      {
        "type": "color_scheme",
        "id": "tabs_color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "background-1"
      },
      {
      "type": "range",
      "id": "tab_font",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Tabs heading font desktop",
      "default": 16
    },
     {
        "type": "text_alignment",
        "id": "tab_font_align",
        "label": "Heading alignment",
        "default": "center"
     },
    {
        "type": "text_alignment",
        "id": "tab_content_align",
        "label": "Tab content alignment",
        "default": "left"
     },
    {
      "type": "range",
      "id": "tab_font_mb",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Tabs heading font mobile",
      "default": 14
    },
    {
        "type": "text_alignment",
        "id": "tab_font_mb_align",
        "label": "Heading alignment mobile",
        "default": "center"
     },
     {
        "type": "text_alignment",
        "id": "tab_content_align_mb",
        "label": "Tab content alignment mobile",
        "default": "left"
     },
     {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show bottom border",
      "default": true
    },
      {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
   "blocks": [
    {
      "type": "tab",
      "name": "Tabs",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading",
          "info": "Include a heading that explains the tab."
        },
        {
          "type": "checkbox",
          "id": "description",
          "label": "Show Product Description",
          "default": false
        },
         {
          "type": "richtext",
          "id": "tab_content",
          "default": "<p>Some text here</p>",
          "label": "Content"
        },
        {
          "type": "page",
          "id": "page",
          "label": "t:sections.main-product.blocks.collapsible_tab.settings.page.label"
        }
      ]
    }
  ],
   "presets": [
    {
      "name": "Tabs",
      "blocks": [
        {
          "type": "tab"
        },
        {
          "type": "tab"
        },
        {
          "type": "tab"
        }
      ]
    }
  ]
}
{% endschema %}
