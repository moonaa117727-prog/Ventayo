{% doc %}
  @prompt
    Create a "Product Measurements" section with two columns: a left column with a section title (default "Product Measurements") and a subtitle/description text (default "The most detailed information about the product"), and a right column that displays a list of specification rows, each with a bold label and a value separated by a horizontal divider line. Each row should be a repeatable block so merchants can add, remove, and reorder rows. All text (section title, description, each label, and each value) must be editable in the theme editor. The design should match a clean, minimal specification table style with divider lines between rows, similar to a product spec sheet.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-measurements-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-product-measurements__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: start;
  }

  .ai-product-measurements__left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_gap }}px;
  }

  .ai-product-measurements__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-product-measurements__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-product-measurements__right-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-product-measurements__row-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {{ block.settings.label_width }}% 1fr;
    gap: {{ block.settings.row_gap }}px;
    padding: {{ block.settings.row_padding }}px 0;
    border-bottom: {{ block.settings.divider_thickness }}px solid {{ block.settings.divider_color }};
  }

  .ai-product-measurements__row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-product-measurements__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    font-weight: {{ block.settings.label_weight }};
    color: {{ block.settings.label_color }};
    margin: 0;
  }

  .ai-product-measurements__value-{{ ai_gen_id }} {
    font-size: {{ block.settings.value_size }}px;
    font-weight: {{ block.settings.value_weight }};
    color: {{ block.settings.value_color }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-product-measurements__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-product-measurements__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }

    .ai-product-measurements__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-product-measurements__row-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_row_gap }}px;
    }
  }
{% endstyle %}

<product-measurements-{{ ai_gen_id }}
  class="ai-product-measurements-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-measurements__container-{{ ai_gen_id }}">
    <div class="ai-product-measurements__left-{{ ai_gen_id }}">
