gs":{"benefit":"Postage Paid Returns","us":true,"others":false}}},"block_order":["row_QFGxKq","row_iwYGKi","row_txbLrn","row_GpHF9b","row_HQJrEg"],"disabled":true,"settings":{"title":"Why Ventayo's Hearing Aids","heading_size":"h1","text":"","button_label":"","link":"","button_style_secondary":false,"layout":"table_second","color_scheme":"","logo_width":90,"mobile_logo_width":60,"us_label":"","others_label":"Others","benefit_color_scheme":"","checkmark_color":"#53af01","icon_cells_color_scheme":"","table_corner_radius":0,"table_shadow_opacity":15,"table_shadow_horizontal_offset":0,"table_shadow_vertical_offset":0,"table_shadow_blur":0,"table_border_thickness":1,"padding_top":36,"padding_bottom":36}},"collapsible_content_c6NLBG":{"type":"collapsible-content","blocks":{"collapsible_row_r9GMnW":{"type":"collapsible_row","settings":{"heading":"How to use & operate these hearing aids?","icon":"check_mark","row_content":"<p>✔️ Navigating Programs and Adjusting Volume for Ventayo Hearing Aids<br\/><br\/>✔️ Navigating Between Programs:<br\/>To switch between different programs, press and hold the volume button for 2 seconds. Each subsequent 2-second press will cycle through the available program options.<br\/><br\/>✔️ Adjusting Volume:<br\/>To adjust the volume within any program, simply press the volume button quickly (without holding). This will allow you to either increase or decrease the volume to your desired level.<\/p>","page":""}},"collapsible_row_bVrKUr":{"type":"collapsible_row","settings":{"heading":"How long does it take to charge?","icon":"check_mark","row_content":"<p>Our devices can reach a full charge in as little a 2-3 hours. You can expect up to 30+ Hours of continuous use on a single charge.<\/p>","page":""}},"collapsible_row_mUp84h":{"type":"collapsible_row","settings":{"heading":"Do I need a hearing test?","icon":"check_mark","row_content":"<p>Absolutely not! Our devices come pre-configured for the most common types of hearing loss and are ready to use right out of the box. They are also easily adjustable, as detailed in the user manual, to fit your specific needs. Generally, they work perfectly for most of our customers. However, if your hearing loss requires a more specialized solution and our device doesn’t meet your needs, simply let us know within 30 days. We will fully refund your purchase as part of our “Love It or It’s Free Guarantee.”<\/p>","page":""}},"collapsible_row_JimYED":{"type":"collapsible_row","settings":{"heading":"Will this fit my ears?","icon":"check_mark","row_content":"<p>We include a variety of sized earbuds with each hearing aid. You can choose the best fit for you. 99% of our customers get the best fit from 1 of the three options in your order.<\/p>","page":""}},"collapsible_row_7q4yfJ":{"type":"collapsible_row","settings":{"heading":"How are prices so low? What’s the catch?","icon":"check_mark","row_content":"<p>Did you know that two-thirds of the cost of most hearing aids goes towards paying the salary of a doctor or audiologist? It doesn't seem fair, does it? That's why we've eliminated the middlemen, doctors, and sales offices to offer you state-of-the-art hearing aids at a fraction of the cost of other companies. Now, you can get premium, high-end hearing aids without breaking the bank!<\/p>","page":""}},"collapsible_row_jJMDxk":{"type":"collapsible_row","settings":{"heading":"When do you dispatch the product?","icon":"check_mark","row_content":"<p>Orders are processed within 12-24 hours. Orders placed before 2pm will be processed same day.<\/p>","page":""}},"collapsible_row_B7AAeT":{"type":"collapsible_row","settings":{"heading":"What is Your return Policy?","icon":"check_mark","row_content":"<p>We are offering 100-Day Money Back Guarantee with postage paid return. <\/p>","page":""}},"collapsible_row_iekRJH":{"type":"collapsible_row","disabled":true,"settings":{"heading":"Collapsible row","icon":"check_mark","row_content":"","page":""}}},"block_order":["collapsible_row_r9GMnW","collapsible_row_bVrKUr","collapsible_row_mUp84h","collapsible_row_JimYED","collapsible_row_7q4yfJ","collapsible_row_jJMDxk","collapsible_row_B7AAeT","collapsible_row_iekRJH"],"settings":{"caption":"","heading":"FAQ's","heading_size":"h1","heading_alignment":"center","layout":"none","color_scheme":"","container_color_scheme":"","open_first_collapsible_row":false,"image_ratio":"adapt","desktop_layout":"image_second","heading_size_row":"h3","padding_top":36,"padding_bottom":36}},"related-products":{"type":"related-products","disabled":true,"settings":{"heading":"You may also like","heading_size":"h2","collection_text_alignment":"left","products_to_show":4,"columns_desktop":4,"color_scheme":"background-1","image_ratio":"square","show_secondary_image":true,"show_vendor":false,"show_rating":false,"enable_quick_desc":false,"quick_desc_legth":90,"quick_desc_size":13,"columns_mobile":"2","padding_top":36,"padding_bottom":28}},"1756433575b0c5c80c":{"type":"apps","blocks":{"judge_me_reviews_medals_QJdgzF":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/medals\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{}}},"block_order":["judge_me_reviews_medals_QJdgzF"],"settings":{"include_margins":true}},"34037d18-7d72-489c-82b9-03de2db445a2":{"type":"lumin-review","blocks":{"review_byUpjA":{"type":"review","settings":{"name_text":"Ana M.","date_text":"May 2024","review_head":"Express Shipping","review_text":"Arrived safely and in perfect condition. These hearing aids are extremely easy to use and not at all fiddly. The volume control features a small, raised knob that can be easily adjusted with fingernails or tweezers. I love the charging case, which functions just like those for regular earphones. They work wonderfully and noticeably enhance my hearing.","like_size":0,"dislike_size":0,"feature_font_size":16}},"review_faYRdU":{"type":"review","settings":{"name_text":"Amanda G.","date_text":"June 2024","review_head":"Regained Connection with Loved Ones","review_text":"Ventayo’s hearing aids have given me back something I thought I had lost forever – the ability to connect with my loved ones. Hearing my grandchildren's laughter and engaging in conversations with my family has brought so much joy and warmth back into my life. I am forever grateful for this life-changing product.","like_size":87,"dislike_size":0,"feature_font_size":16}},"review_67yTcH":{"type":"review","settings":{"name_text":"Jenny P.","date_text":"June 2024","review_head":"Highly Effective","review_text":"The hearing aids are highly effective. They have made a significant improvement in my hearing, and I no longer struggle in conversations. The quality and performance are exceptional.","like_size":29,"dislike_size":0,"feature_font_size":16}},"review_YV8Nyg":{"type":"review","settings":{"name_text":"Anon.","date_text":"May 2024","review_head":"Perfect fit","review_text":"Finding hearing aids that fit well can be challenging, but Ventayo’s hearing aids fit me perfectly. They are secure and comfortable, and the sound quality is outstanding. I’m very impressed.","like_size":61,"dislike_size":0,"feature_font_size":16}},"review_VdmAgj":{"type":"review","settings":{"name_text":"Kayle H.","date_text":"June 2024","review_head":"Enhanced Listening Experience","review_text":"These hearing aids have greatly enhanced my listening experience. Whether I'm at home, in a restaurant, or attending a live event, the sound is always clear and natural. Ventayo has done an amazing job.","like_size":31,"dislike_size":0,"feature_font_size":16}},"review_WDTr4t":{"type":"review","settings":{"name_text":"Joy Hilburg.","date_text":"May 2024","review_head":"Lightweight and Comfortable","review_text":"The hearing aids are lightweight and very comfortable. I can wear them all day without any discomfort. The sound quality is excellent, making them a great choice for anyone with hearing loss","like_size":48,"dislike_size":0,"feature_font_size":16}},"review_4gaxtA":{"type":"review","settings":{"name_text":"Anon.","date_text":"May 2024","review_head":"Great for Outdoor Activities","review_text":"Nice Product. I'm happy with my purchase.","like_size":20,"dislike_size":0,"feature_font_size":16}},"review_UbW7Pn":{"type":"review","settings":{"name_text":"Johan D.","date_text":"June 2024","review_head":"Clear Conversations","review_text":"Since getting Ventayo’s hearing aids, I can finally have clear conversations with my friends and family. No more asking people to repeat themselves. These hearing aids have made a huge difference.","like_size":34,"dislike_size":0,"feature_font_size":16}},"review_Fm7U3w":{"type":"review","settings":{"name_text":"Ali D.","date_text":"April 2024","review_head":"Helpful Customer Support","review_text":"The customer support team at Ventayo was very helpful when I had questions about my hearing aids. They provided prompt and detailed responses, ensuring I was satisfied with my purchase. Great service!","like_size":27,"dislike_size":0,"feature_font_size":16}},"review_nGGDcj":{"type":"review","settings":{"name_text":"Arabella J.","date_text":"June 2024","review_head":"Fantastic Value for Money","review_text":"The hearing aids offer fantastic value for money. They are affordable without compromising on quality. The sound is clear, and they are very comfortable to wear. I’m so glad I found these.","like_size":0,"dislike_size":0,"feature_font_size":16}},"review_7nLwLf":{"type":"review","settings":{"name_text":"Lexie D.","date_text":"May 2024","review_head":"Rediscovering Music","review_text":"I used to love listening to music, but hearing loss took that joy away from me. Ventayo’s hearing aids have changed that. The first time I put them on, I played my favorite song and cried. The clarity and richness of the sound brought back so many memories and emotions. Thank you, Ventayo, for giving music back to me.","like_size":0,"dislike_size":0,"feature_font_size":16}},"review_z3mELD":{"type":"review","settings":{"name_text":"Johan D.","date_text":"June 2024","review_head":"Restoring Confidence","review_text":"Living with hearing loss made me self-conscious and withdrawn. Ventayo’s hearing aids have restored my confidence and allowed me to engage with the world again. I can participate in meetings at work, enjoy social gatherings, and no longer feel embarrassed about asking people to repeat themselves. These hearing aids have truly changed my life.","like_size":0,"dislike_size":0,"feature_font_size":16}},"review_VYredr":{"type":"review","settings":{"name_text":"Jordan D.","date_text":"June 2024","review_head":"Overcoming Isolation","review_text":"For years, I felt isolated because of my hearing loss. I missed out on conversations and felt disconnected from those around me. Ventayo’s hearing aids have broken down those barriers. I can now hear clearly, participate fully, and feel connected to the world again. It’s been an emotional and transformative experience.","like_size":49,"dislike_size":0,"feature_font_size":16}},"review_9dzCDx":{"type":"review","settings":{"name_text":"Jonathan D.","date_text":"June 2024","review_head":"Highly Recommended","review_text":"I highly recommend Ventayo's hearing aids to anyone in need of hearing assistance. They are affordable, high-quality, and come with excellent customer support. I couldn't be happier with my purchase.","like_size":100,"dislike_size":0,"feature_font_size":16}},"review_AJJdYG":{"type":"review","settings":{"name_text":"Jurgen L.","date_text":"April 2024","review_head":"Sleek Design","review_text":"these hearing aids have a sleek and modern design. They are stylish and discreet, and I feel confident wearing them. Plus, they work exceptionally well, providing clear and natural sound.","like_size":0,"dislike_size":0,"feature_font_size":16}},"review_9ypVpE":{"type":"review","settings":{"name_text":"Johan D.","date_text":"Feb 2024","review_head":"Great for Active Lifestyles","review_text":"I have an active lifestyle, and Ventayo's hearing aids have kept up with me every step of the way. They stay secure during my workouts and outdoor activities, and the sound remains clear and consistent.","like_size":0,"dislike_size":0,"feature_font_size":16}},"review_9PNdPx":{"type":"review","settings":{"name_text":"Gabriel D.","date_text":"April 2024","review_head":"Crystal Clear Sound","review_text":"The sound quality of Ventayo's hearing aids is crystal clear. I can hear every word during conversations and enjoy music and TV like never before. These hearing aids are a game-changer!","like_size":0,"dislike_size":0,"feature_font_size":16}}},"block_order":["review_byUpjA","review_faYRdU","review_67yTcH","review_YV8Nyg","review_VdmAgj","review_WDTr4t","review_4gaxtA","review_UbW7Pn","review_Fm7U3w","review_nGGDcj","review_7nLwLf","review_z3mELD","review_VYredr","review_9dzCDx","review_AJJdYG","review_9ypVpE","review_9PNdPx"],"settings":{"editing":true,"color_scheme":"","header_text":"","show_top":false,"rating":"4.9","rating_count":"Join our satisfied 30K+ happy customers and experience the transformative power of Ventayo's Hearing aids","review_column_mobile":"1","review_column_tab":"1","review_column_desk":"4","review_load":"4","load_text":"Load More","rw_img_size":120,"rw_img_radius":8,"block_name_size":20,"date_size":10,"block_head_size":20,"block_text_size":14,"show_border":false,"rw_border":"#f3f3f3","border_radius":10,"section_bg3":"#000000","section_bg2":"#5a841c","verify_text":"Verified Buyer","review_bg":"#ffffff","feature_svg_color":"#d4af37","feature_acc_color":"#ff7e8d","review_pd":48,"review_pd_m":20,"show_footer":true,"show_product":true,"like_text":"Was this helpful?","rw_margin":0,"padding_top":36,"padding_bottom":36}}},"order":["2901c3cb-238c-4ae5-ad93-576fa7b45359","main","rich_text_9gjpUF","a1098323-9921-48ef-9777-4dd2323c4c96","96be040c-0828-498a-bae0-77a723676bd3","e0aed494-cfe3-4019-aa56-e5ab74232359","image_with_text_K4dGAc","comparison_table_RdykQD","collapsible_content_c6NLBG","related-products","1756433575b0c5c80c","34037d18